# Copie este arquivo para "backend/.env" e preencha com os dados do Neon.
# O .env NAO vai pro Git (esta no .gitignore).
# Dados em: painel do Neon > Connect > Java (JDBC), com "Connection pooling" desligado.
DB_URL=jdbc:postgresql://SEU-HOST.neon.tech/neondb?sslmode=require
DB_USER=neondb_owner
DB_PASSWORD=sua_senha_aqui
CORS_ALLOWED_ORIGINS=http://localhost:4200
