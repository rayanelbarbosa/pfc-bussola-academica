# Copie este arquivo para "backend/.env" e preencha com os dados do Neon.
# O .env NAO vai pro Git (esta no .gitignore).
# Dados em: painel do Neon > Connect > Java (JDBC), com "Connection pooling" desligado.
DB_URL=jdbc:postgresql://SEU-HOST.neon.tech/neondb?sslmode=require
DB_USER=neondb_owner
DB_PASSWORD=sua_senha_aqui
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Autenticacao (gere com: openssl rand -base64 48)
JWT_SECRET=cole_aqui_um_segredo_com_mais_de_32_caracteres

# Administrador inicial (criado automaticamente na primeira execucao)
ADMIN_EMAIL=admin@bussolaacademica.com.br
ADMIN_PASSWORD=troque_esta_senha_123

# YouTube Data API v3 (Google Cloud Console > APIs e servicos > Credenciais)
YOUTUBE_API_KEY=sua_chave_aqui

# Recuperacao de senha por e-mail (Resend > API keys, permissao "Sending access" no dominio mail.bussolaacademica.com.br)
RESEND_API_KEY=re_sua_chave_aqui
FRONTEND_URL=http://localhost:4200
